# =================================================
# Unimag Interface
# =================================================

# =================================================
# Aliases for current and voltage
# =================================================

alias("$(P)$(R)CurrentRBV","$(P)$(R)CURRENT_RB")
alias("$(P)$(R)OutputVoltage","$(P)$(R)VOLTAGE_RB")
alias("$(P)$(R)Setpoint","$(P)$(R)CURRENT_SP")


# State calculation
record(calcout, "$(P)$(R)state_calc") {
    field(DESC, "Calculate state from status bits")
    field(SCAN,"1 second")
    field(INPA, "$(P)$(R)SupplyOn")
    field(INPB, "$(P)$(R)GenericFault")
    field(INPC, "$(P)$(R)FETovertemp")
    field(INPD, "$(P)$(R)ShuntOvertemp")
    field(INPE, "$(P)$(R)DCunderV")
    field(INPF, "$(P)$(R)ExternalInterlock1")
    field(CALC, "A=0?0:(F=1?4:(B||C||D||E)?5:1)")
    field(OUT, "$(P)$(R)STATE_RB PP")
    field(OOPT, "Every Time")

}

record(mbbi, "$(P)$(R)STATE_RB") {
    field(DESC, "State readback")
    field(SCAN,"Passive")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FRVL, "4")
    field(FRST, "INTERLOCK")
    field(FRSV, "MAJOR") 
    field(FVVL, "5")
    field(FVST, "ERROR")
    field(FVSV, "MAJOR")
    
}

##
## State setpoint
record(mbbo, "$(P)$(R)STATE_SP") {
    field(DESC, "State setpoint")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FRVL, "4")
    field(FRST, "INTERLOCK")
    field(FVVL, "5")
    field(FVST, "ERROR")
    field(FLNK, "$(P)$(R)state_to_enable")
}

# Map state to Enable: only OFF, ON and STANDBY touch the output
record(calcout, "$(P)$(R)state_to_enable") {
    field(DESC, "Map state to Enable")
    field(INPA, "$(P)$(R)STATE_SP")
    field(CALC, "A=0||A=1||A=2")
    field(OCAL, "A=1")
    field(DOPT, "Use OCAL")
    field(OUT, "$(P)$(R)Enable PP")
    field(OOPT, "When Non-zero")
    field(FLNK, "$(P)$(R)state_to_reset")
}

# Map state to Reset
record(calcout, "$(P)$(R)state_to_reset") {
    field(DESC, "Map state to Reset")
    field(INPA, "$(P)$(R)STATE_SP")
    field(CALC, "A=3")
    field(OUT, "$(P)$(R)Reset PP")
    field(OOPT, "When Non-zero")
}

# =================================================
# UNIMAG state machine (STATE_SM)
# =================================================
# The supply is naturally bipolar: GOZERO, GOPOS and GONEG are never used.
#   0 READY | 1 GOTOSET | 2 GOTOSTATE | 6 SPNOTSET (MINOR) | 7 STATENOTSET (MAJOR)
# Both checks are armed by the first command after boot, so that a supply left
# running is not reported. SET_TIMEOUT_S restarts on progress and on a new command.

record(ao, "$(P)$(R)SET_TOLERANCE") {
    field(DESC, "Current setpoint tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=0.1)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P)$(R)SET_TIMEOUT_S") {
    field(DESC, "Setpoint/state timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "3600")
}

# ---------- setpoint ----------
record(calc, "$(P)$(R)SP_ERR") {
    field(DESC, "Setpoint error")
    field(INPA, "$(P)$(R)CurrentRBV NPP NMS")
    field(INPB, "$(P)$(R)Setpoint NPP NMS")
    field(CALC, "ABS(A-B)")
    field(EGU,  "A")
    field(PREC, "3")
}

record(calc, "$(P)$(R)SP_ARMED") {
    field(DESC, "Setpoint command seen since boot")
    field(INPA, "$(P)$(R)Setpoint NPP NMS")
    field(INPB, "$(P)$(R)SP_LAST NPP NMS")
    field(INPC, "$(P)$(R)SP_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

record(calc, "$(P)$(R)SP_WDOG") {
    field(DESC, "Setpoint unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P)$(R)SP_ERR PP NMS")
    field(INPB, "$(P)$(R)SP_WDOG NPP NMS")
    field(INPC, "$(P)$(R)ERR_LAST NPP NMS")
    field(INPD, "$(P)$(R)SET_TOLERANCE NPP NMS")
    field(INPF, "$(P)$(R)Setpoint NPP NMS")
    field(INPG, "$(P)$(R)SP_LAST NPP NMS")
    field(INPH, "$(P)$(R)STATE_RB NPP NMS")
    field(INPI, "$(P)$(R)SP_ARMED PP NMS")
    field(CALC, "!I||D<=0||H!=1?0:(A<=D?0:(F!=G||A<C-D/20?0:B+1))")
    field(FLNK, "$(P)$(R)SP_NOT_REACHED")
}

record(calc, "$(P)$(R)SP_NOT_REACHED") {
    field(DESC, "Setpoint not reached in time")
    field(INPA, "$(P)$(R)SP_WDOG NPP NMS")
    field(INPB, "$(P)$(R)SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P)$(R)SP_LAST")
}

record(calc, "$(P)$(R)SP_LAST") {
    field(DESC, "Previous setpoint")
    field(INPA, "$(P)$(R)Setpoint NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P)$(R)ERR_LAST")
}

record(calc, "$(P)$(R)ERR_LAST") {
    field(DESC, "Previous setpoint error")
    field(INPA, "$(P)$(R)SP_ERR NPP NMS")
    field(CALC, "A")
}

record(calc, "$(P)$(R)SP_BUSY") {
    field(DESC, "Going to the setpoint")
    field(INPA, "$(P)$(R)SP_ERR NPP NMS")
    field(INPB, "$(P)$(R)SET_TOLERANCE NPP NMS")
    field(INPC, "$(P)$(R)SP_ARMED NPP NMS")
    field(INPD, "$(P)$(R)STATE_RB NPP NMS")
    field(CALC, "C&&B>0&&D=1&&A>B")
}

# ---------- state ----------
record(calc, "$(P)$(R)ST_ARMED") {
    field(DESC, "State command seen since boot")
    field(INPA, "$(P)$(R)STATE_SP NPP NMS")
    field(INPB, "$(P)$(R)ST_LAST NPP NMS")
    field(INPC, "$(P)$(R)ST_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

# OFF and STANDBY both read back as OFF, interlocks and errors do not count
record(calc, "$(P)$(R)ST_WDOG") {
    field(DESC, "State unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P)$(R)STATE_SP NPP NMS")
    field(INPB, "$(P)$(R)ST_LAST NPP NMS")
    field(INPC, "$(P)$(R)STATE_RB NPP NMS")
    field(INPD, "$(P)$(R)ST_WDOG NPP NMS")
    field(INPE, "$(P)$(R)ST_ARMED PP NMS")
    field(CALC, "!E||C>=3||A!=B||(A=1?C=1:(A=0||A=2?C=0:1))?0:D+1")
    field(FLNK, "$(P)$(R)ST_NOT_REACHED")
}

record(calc, "$(P)$(R)ST_NOT_REACHED") {
    field(DESC, "State not reached in time")
    field(INPA, "$(P)$(R)ST_WDOG NPP NMS")
    field(INPB, "$(P)$(R)SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P)$(R)ST_LAST")
}

record(calc, "$(P)$(R)ST_LAST") {
    field(DESC, "Previous state command")
    field(INPA, "$(P)$(R)STATE_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
}

# ---------- reset ----------
# RESET also restarts both timeouts, clearing SPNOTSET and STATENOTSET
# (redefines the Reset record of devEasyDriver.db, adding the FLNK)
record(bo, "$(P)$(R)Reset") {
    field(FLNK, "$(P)$(R)WDOG_CLEAR")
}

record(dfanout, "$(P)$(R)WDOG_CLEAR") {
    field(DESC, "Clear the watchdogs")
    field(VAL,  "0")
    field(OUTA, "$(P)$(R)SP_WDOG.VAL NPP")
    field(OUTB, "$(P)$(R)ST_WDOG.VAL NPP")
}

# ---------- result ----------
record(calcout, "$(P)$(R)STATE_SM_CALC") {
    field(DESC, "Compute STATE_SM")
    field(SCAN, "1 second")
    field(INPA, "$(P)$(R)ST_NOT_REACHED NPP NMS")
    field(INPB, "$(P)$(R)SP_NOT_REACHED NPP NMS")
    field(INPC, "$(P)$(R)ST_WDOG NPP NMS")
    field(INPD, "$(P)$(R)SP_BUSY PP NMS")
    field(CALC, "A?7:(B?6:(C>0?2:(D?1:0)))")
    field(OUT,  "$(P)$(R)STATE_SM PP")
    field(OOPT, "Every Time")
}

record(mbbi, "$(P)$(R)STATE_SM") {
    field(DESC, "UNIMAG state machine")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "READY")
    field(ONVL, "1")
    field(ONST, "GOTOSET")
    field(TWVL, "2")
    field(TWST, "GOTOSTATE")
    field(THVL, "3")
    field(THST, "GOZERO")
    field(FRVL, "4")
    field(FRST, "GOPOS")
    field(FVVL, "5")
    field(FVST, "GONEG")
    field(SXVL, "6")
    field(SXST, "SPNOTSET")
    field(SXSV, "MINOR")
    field(SVVL, "7")
    field(SVST, "STATENOTSET")
    field(SVSV, "MAJOR")
}
